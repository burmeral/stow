;; Generated by matugen - do not edit manually
(deftheme matugen "Material You theme generated by matugen")

(custom-theme-set-faces
 'matugen
 `(default                      ((t (:background "{{colors.background.default.hex}}" :foreground "{{colors.on_background.default.hex}}"))))
 `(cursor                       ((t (:background "{{colors.primary.default.hex}}"))))
 `(region                       ((t (:background "{{colors.primary_container.default.hex}}"))))
 `(highlight                    ((t (:background "{{colors.surface_container_high.default.hex}}"))))
 `(fringe                       ((t (:background "{{colors.surface.default.hex}}"))))
 `(line-number                  ((t (:foreground "{{colors.outline.default.hex}}" :background "{{colors.surface.default.hex}}"))))
 `(line-number-current-line     ((t (:foreground "{{colors.primary.default.hex}}" :background "{{colors.surface_container.default.hex}}"))))
 `(mode-line                    ((t (:background "{{colors.surface_container_high.default.hex}}" :foreground "{{colors.on_surface.default.hex}}"))))
 `(mode-line-inactive           ((t (:background "{{colors.surface_container.default.hex}}" :foreground "{{colors.outline.default.hex}}"))))
 `(minibuffer-prompt            ((t (:foreground "{{colors.primary.default.hex}}"))))
 `(font-lock-builtin-face       ((t (:foreground "{{colors.tertiary.default.hex}}"))))
 `(font-lock-comment-face       ((t (:foreground "{{colors.outline.default.hex}}" :slant italic))))
 `(font-lock-constant-face      ((t (:foreground "{{colors.secondary.default.hex}}"))))
 `(font-lock-function-name-face ((t (:foreground "{{colors.primary.default.hex}}"))))
 `(font-lock-keyword-face       ((t (:foreground "{{colors.tertiary.default.hex}}" :weight bold))))
 `(font-lock-string-face        ((t (:foreground "{{colors.secondary_container.default.hex}}"))))
 `(font-lock-type-face          ((t (:foreground "{{colors.secondary.default.hex}}"))))
 `(font-lock-variable-name-face ((t (:foreground "{{colors.on_surface.default.hex}}"))))
 `(font-lock-warning-face       ((t (:foreground "{{colors.error.default.hex}}"))))
 `(error                        ((t (:foreground "{{colors.error.default.hex}}"))))
 `(warning                      ((t (:foreground "{{colors.tertiary.default.hex}}"))))
 `(success                      ((t (:foreground "{{colors.secondary.default.hex}}"))))
 `(link                         ((t (:foreground "{{colors.primary.default.hex}}" :underline t))))
 `(org-block                    ((t (:background "{{colors.surface_container.default.hex}}"))))
 `(org-block-begin-line         ((t (:foreground "{{colors.outline.default.hex}}"))))
 `(org-level-1                  ((t (:foreground "{{colors.primary.default.hex}}" :weight bold))))
 `(org-level-2                  ((t (:foreground "{{colors.secondary.default.hex}}" :weight bold))))
 `(org-level-3                  ((t (:foreground "{{colors.tertiary.default.hex}}" :weight bold))))
)

(provide-theme 'matugen)
