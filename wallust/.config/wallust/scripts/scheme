#!/usr/bin/env bash
set -euo pipefail

SCHEMES="$HOME/.config/wallust/schemes"

case "${1:-}" in
    list)
        for theme in "$SCHEMES"/*.json; do
            basename "$theme" .json
        done | sort
        ;;

    preset)
        shift
        wallust theme "$@"
        ;;

    *)
        [[ $# -eq 0 ]] && {
            echo "Usage:"
            echo "  scheme list"
            echo "  scheme <name>"
            echo "  scheme preset <wallust-theme>"
            exit 1
        }

        wallust cs -f terminal-sexy "$SCHEMES/$1.json"
        ;;
esac
