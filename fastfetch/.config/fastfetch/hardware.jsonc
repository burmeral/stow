{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "display": {
        "separator": "    "
    },
    "modules": [
	"break",
	"break",

    {
        "type": "host",
        "key": "host           ",
        "keyColor": "33"
    },
    {
        "type": "cpu",
        "key": "cpu            ",
        "keyColor": "33"
    },
    {
        "type": "gpu",
        "key": "gpu            ",
        "keyColor": "33"
    },
    {
        "type": "memory",
        "key": "memory         ",
        "keyColor": "33"
    },
    {
        "type": "disk",
        "key": "disk           ",
        "keyColor": "33"
    },
    {
        "type": "battery",
        "key": "battery        ",
        "keyColor": "33"
    },
    {
        "type": "uptime",
        "key": "uptime         ",
        "keyColor": "33"
    }

 ]
}
